# =============================================================================
# Net Tools - variaveis de configuracao
# =============================================================================
# Copie para ".env" (ou rode "./manager-docker.sh init-env", que gera os
# segredos aleatorios). O ".env" e local da VM e gitignored.

# --- Composicao -----------------------------------------------------------
# Caminho do .env (relativo resolvido para absoluto pelo manager).
RCONFIG_ENV_PATH=./.env

# Restricao de no do Swarm (hostname da VM do cliente; vmssuproxy = automatico)
SWARM_NODE_CONSTRAINT=vmssuproxy

# Porta HTTP publicada no host (acesso via IP local / Tailscale).
APP_PORT=8090

# --- Aplicacao ------------------------------------------------------------
APP_NAME="Net Tools"
# Textos de branding (deixe vazio para o padrao).
BRAND_LOGIN=""
BRAND_APP=""
# Chave para cifrar as senhas dos devices em repouso (NUNCA mude depois de
# cadastrar devices - os segredos deixam de ser decifrados). Gerada no init-env.
SECRET_KEY=
# Chave da sessao (cookie de login). Gerada no init-env.
SESSION_SECRET=
# Expiracao da sessao por inatividade (segundos). Padrao: 43200 (12h).
SESSION_MAX_AGE=43200
# Marcar cookie como Secure (use true se expor via HTTPS/Nginx).
SESSION_HTTPS_ONLY=false

# Usuario admin inicial (criado no primeiro start). Defina a senha aqui.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Exigir aprovacao para aplicar mudancas (dry-run nunca exige).
REQUIRE_APPROVAL=true

# Fuso horario (log/agendamento). [EDIT]
TIMEZONE=America/Sao_Paulo

# --- Netmiko --------------------------------------------------------------
# Conexoes simultaneas e timeout (segundos)
NETMIKO_MAX_WORKERS=10
NETMIKO_CONN_TIMEOUT=30
