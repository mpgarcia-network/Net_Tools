# =============================================================================
# rConfig - variáveis de configuração do cliente
# =============================================================================
# Copie para ".env" (ou rode "./manager-docker.sh init-env", que já gera senhas
# aleatórias de banco). O ".env" é local da VM, gitignored, e é o mesmo arquivo
# bind-mountado no container como config do Laravel — NÃO perca nem versiona.
#
# Ajustes obrigatórios por cliente:
#   SWARM_NODE_CONSTRAINT -> hostname do nó (deixe vazio para usar o hostname do nó)
#   APP_URL               -> URL de acesso ao web UI (https://<IP-do-proxy>:8443)
#   TIMEZONE              -> fuso do cliente (padrão America/Sao_Paulo)

# --- Composição (usadas pelo manager-docker.sh no deploy) -----------
# Caminho do .env (relativo resolvido para absoluto pelo manager).
RCONFIG_ENV_PATH=./.env

# Datadir do MariaDB em bind path no host (facilita backup/restore).
# Dono do dir: 999:999 (mysql) — o manager cria/ajusta no start.
RCONFIG_DB_DATA_PATH=./data/mariadb

# Config do Nginx (conf.d/default.conf) e certificados TLS (rconfig.crt/.key).
# Relativos ao diretório da stack; o manager resolve para absoluto no start e
# gera um par self-signed se nginx/ssl estiver vazio.
RCONFIG_NGINX_CONF_PATH=./nginx/conf.d
RCONFIG_NGINX_SSL_PATH=./nginx/ssl

# Portas publicadas pelo Nginx no host (8088 HTTP -> 80, 8443 HTTPS -> 443).
# Mantém 80/443 livres para outros serviços/ingress.
RCONFIG_HTTP_PORT=8088
RCONFIG_HTTPS_PORT=8443

# --- Patch "Keep Unchanged Config" ---------------------------------
# Não grava novo arquivo/registro quando a config baixada é igual à última
# (comportamento tipo Oxidized, que o Core não tem nativo). O patch sobrescreve
# a classe SaveConfigsToDiskAndDb do Core via bind mount; use false para voltar
# ao comportamento original.
RCONFIG_KEEP_UNCHANGED=true
# Caminho do patch (relativo ao diretório da stack; o manager resolve p/ absoluto).
RCONFIG_PATCH_PATH=./patch/SaveConfigsToDiskAndDb.php

# Restrição de nó do Swarm onde a stack deve rodar (hostname da VM do cliente)
SWARM_NODE_CONSTRAINT=

# ---------------------------------------------------------------------------
# rConfig V8 Core - environment (upstream)
#
# Este bloco é o .env do Laravel e das variáveis de composição do rConfig.
# Vai bind-mountado no container como /var/www/html/rconfig/.env.
# ---------------------------------------------------------------------------

# Prebuilt image version to run. Pin to a release (recommended) or use "latest".
# See https://hub.docker.com/r/rconfig/rconfig/tags for available versions. [EDIT]
RCONFIG_VERSION=8.2.17

# --- Application ---------------------------------------------------------
APP_NAME="rConfig V8 Core"
APP_ENV=production
# Deixe APP_KEY vazio numa instalação nova: o container gera e grava de volta
# aqui. Nunca troque num banco existente (senhas dos devices são encriptadas).
APP_KEY=
APP_DEBUG=false
# URL de acesso ao web UI (HTTPS via Nginx). Ajuste para o IP do proxy. [EDIT]
APP_URL=https://localhost:8443
# Parâmetros do rConfig V8 para operar atrás de reverse proxy.
APP_FORCE_HTTPS=true
TRUSTED_PROXIES=*
# Hosts (com porta) pelos quais a UI é acessada. O /log-viewer (e o Sanctum)
# só recebem a sessão de hosts "stateful" — inclua LAN e Tailscale. [EDIT]
SANCTUM_STATEFUL_DOMAINS=localhost:8443
LOG_VIEWER_API_STATEFUL_DOMAINS=localhost:8443
APP_DIR_PATH=/var/www/html/rconfig

LOG_CHANNEL=daily
LOG_LEVEL=warning

# --- Database ------------------------------------------------------------
# Senhas geradas aleatoriamente no primeiro "start" (init-env). Não use default.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=rconfig
DB_USERNAME=rconfig_user
DB_PASSWORD=rconfig_pass
MYSQL_ROOT_PASSWORD=root_password
# Porta do banco no host. No padrão Swarm rConfig o MariaDB NÃO é publicado
# (só interno). Para expor temporariamente:
#   docker service update --publish-add published=3307,target=3306 rconfig_db
DB_PORT_HOST=3307

# --- Cache / queue / session (Redis) ------------------------------------
BROADCAST_DRIVER=log
CACHE_DRIVER=redis
CACHE_PREFIX=rConfigp
QUEUE_CONNECTION=redis
QUEUE_DRIVER=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
REDIS_QUEUE_RETRY_AFTER=130
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Horizon (queue workers) --------------------------------------------
HORIZON_PREFIX=rConfig
HORIZON_LOCAL_TIMEOUT=120
HORIZON_PROD_TIMEOUT=120
HORIZON_MIN_PROCESS=1
HORIZON_MAX_PROCESS=10
HORIZON_DEFAULT_MAX_PROCESS=5

# --- Mail ----------------------------------------------------------------
# Defaults route mail to the log. Point at a real SMTP host for notifications.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@rconfig.local
MAIL_FROM_NAME=rConfig

# --- rConfig -------------------------------------------------------------
RCONFIG_API_TOKEN=V8Core
RCONFIG_SUB_ID="V8Core"
RCONFIG_SUB_NAME="V8Core"
RCONFIG_SUB_STATUS="Active"
RCONFIG_SUB_EXPIRY="N/A"
MASK_DEVICE_CREDENTIALS=false

# Fuso do cliente. [EDIT]
TIMEZONE=America/Sao_Paulo

ENLIGHTN_SKIP_ENVIRONMENT_SPECIFIC=false

# --- Single sign-on (optional) ------------------------------------------
# Uncomment and fill in only if you use SSO. See the docs for each provider.
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_REDIRECT_URI=
# MICROSOFT_TENANT_ID=
# OKTA_BASE_URL=
# OKTA_CLIENT_ID=
# OKTA_CLIENT_SECRET=
# OKTA_REDIRECT_URI=
# SAML2_METADATA_URL=
# SAML2_SP_CERTIFICATE=
# SAML2_SP_PRIVATE_KEY=