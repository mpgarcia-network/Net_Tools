# https://github.com/crazy-max/docker-msmtpd - relay SMTP para envio de e-mail
# Copie para "msmtpd.env" (o manager faz isso) e ajuste conforme o provedor.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=on
SMTP_STARTTLS=on
SMTP_TLS_CHECKCERT=on
SMTP_AUTH=on
SMTP_USER=foo
SMTP_PASSWORD=bar
SMTP_FROM=foo@gmail.com
