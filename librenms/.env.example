# Net Tools - LibreNMS (variaveis de deploy)
# Copie para ".env" (ou rode ./manager-docker.sh init-env).

TZ=America/Sao_Paulo

# UID/GID do usuario dono do volume /data (no host)
PUID=1000
PGID=1000

# Porta HTTP publicada no host
APP_PORT=8001

# Banco de dados (defina a senha!)
MYSQL_DATABASE=librenms
MYSQL_USER=librenms
MYSQL_PASSWORD=
